# Copiar a .env (cp .env.example .env) y llenar con las credenciales sandbox.
# Este archivo NO debe tener valores reales.

# Factus Facturación (sandbox)
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
FACTUS_NUMBERING_RANGE_ID=

# Factus Pay (sandbox)
# Ojo: solo existe un token activo por usuario. En local usen el mock o coordinen
# para no autenticarse en paralelo con el servidor desplegado.
FACTUS_PAY_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_EMAIL=
FACTUS_PAY_PASSWORD=
# 32+ caracteres aleatorios, igual al registrado en el panel de Factus Pay
FACTUS_PAY_WEBHOOK_KEY=

# App
DATABASE_URL=
PORT=3000
APP_PUBLIC_URL=
NODE_ENV=development
