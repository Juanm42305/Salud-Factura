# Copia este archivo como .env (local) o carga estas variables en el panel de Vercel/Railway.
# NUNCA pongas valores reales aquí: este archivo va al repositorio público.

# ── Factus Facturación (sandbox) ─────────────────────────────
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
# ID del rango de facturas y de notas crédito (los ves en GET /api/salud una vez conectado)
FACTUS_NUMBERING_RANGE_ID=
FACTUS_CREDIT_NOTE_RANGE_ID=
# true = no llama a Factus (solo para maquetar pantallas sin credenciales)
FACTUS_MOCK=false

# ── Factus Pay (sandbox) ─────────────────────────────────────
FACTUS_PAY_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_EMAIL=
FACTUS_PAY_PASSWORD=
# 32+ caracteres aleatorios, igual a la que registren en el panel de Factus Pay
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FACTUS_PAY_WEBHOOK_KEY=
# Solo si Factus se los pide (encabezado X-Factus-Access-Key)
FACTUS_PAY_ACCESS_KEY=
# true en los portátiles del equipo: evita llamar a /auth y revocar el token del servidor desplegado
FACTUS_PAY_MOCK=true

# ── IPS (datos del prestador para la factura SS-CUFE) ────────
IPS_PROVIDER_CODE=
IPS_NOMBRE=IPS SaludFactura Demo
# false = payment_details por el total (confirmado en el sandbox: Factus lo exige así; pregunta 15.4 resuelta)
SS_CUFE_PAGO_DESCUENTA_PREPAGOS=false

# Prefijo del equipo en los reference_code (la cuenta sandbox de Factus es compartida entre equipos).
# Mismo valor en todos los .env del equipo y en el despliegue (el despliegue usa SALUDF42).
# Sin él, ADM-2026-000001 puede devolver el recaudo o la factura de OTRO equipo.
REFERENCIA_EQUIPO=SALUDF42

# ── App ──────────────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string (Transaction pooler, puerto 6543)
DATABASE_URL=
PORT=3000
APP_PUBLIC_URL=
# true en Railway/Render (proceso persistente): corre la cola y el polling cada 30 s
RUN_WORKER=false
# Protege /api/cron/tick si usan un cron externo (cron-job.org) en Vercel
CRON_SECRET=

# ── Supabase Auth (login y verificación en dos pasos del administrador) ──
# Project Settings → API. La URL y la clave publicable se usan en el navegador y en el backend para verificar sesiones.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
